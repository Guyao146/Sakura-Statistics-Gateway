# Copy to .env; generate independent long random passwords before starting.
# Published public image. Pin a version or digest for predictable upgrades.
SAKURA_IMAGE=ghcr.io/guyao146/sakura-statistics-gateway:v0.1.0
# Example URL uses URL-safe characters. Percent-encode special password characters in DATABASE_URL.
POSTGRES_DB=sakura
POSTGRES_USER=sakura
POSTGRES_PASSWORD=replace-with-long-random-db-password
DATABASE_URL=postgres://sakura:replace-with-long-random-db-password@postgres:5432/sakura?sslmode=disable
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-long-random-admin-password
# Production HTTPS: true. Local HTTP on 127.0.0.1:8080 only: false.
SESSION_SECURE=true
# Exact browser-facing origin, no trailing slash. Production: https://stats.example.com
# Local HTTPS profile: https://localhost; local HTTP: http://127.0.0.1:8080
PUBLIC_ORIGIN=http://127.0.0.1:8080
STATISTICS_TIMEZONE=Asia/Shanghai
# HTTPS profile: localhost uses a local CA; production needs a real DNS hostname.
DOMAIN=localhost
